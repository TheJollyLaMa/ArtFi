    "solc": "^0.8.20"
  },
  "dependencies": {
    "@ipld/dag-ucan": "^3.4.5",
    "@openzeppelin/contracts": "^5.6.1",
    "@ucanto/core": "^10.4.6",
    "@ucanto/principal": "^9.0.3",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "nodemailer": "^7.0.0"
  }
