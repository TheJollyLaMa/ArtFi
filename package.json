  "description": "Zero-profit micro-liquidity protocol for Artizen creators. Features automated grant advances, human-in-the-loop onboarding, and smart contract settlement.",
  "main": "index.js",
  "scripts": {
    "test": "hardhat test && node --test test/payroll.test.js test/commentArt.test.js test/ipfsStorage.test.mjs test/browserEmailAuth.test.mjs test/nodeKeeper.test.mjs",
    "test:storage": "node --test test/ipfsStorage.test.mjs test/browserEmailAuth.test.mjs",
    "auth:serve": "node scripts/browserAuthServer.mjs",
    "auth:keygen": "node scripts/generateUcanServiceKey.mjs",
    "network:verify": "node scripts/artfiBootstrap.mjs verify",
    "network:node-hashes": "node scripts/artfiBootstrap.mjs node-hashes",
    "network:register-profile": "node scripts/artfiBootstrap.mjs register-profile",
    "network:publish-content": "node scripts/artfiBootstrap.mjs publish-content",
    "network:create-request": "node scripts/artfiBootstrap.mjs create-request",
    "network:register-node": "node scripts/artfiBootstrap.mjs register-node",
    "network:approve-node": "node scripts/artfiBootstrap.mjs approve-node",
    "network:approve-checker": "node scripts/artfiBootstrap.mjs approve-checker",
    "network:set-challenge": "node scripts/artfiBootstrap.mjs set-challenge",
    "index:network": "node scripts/indexNetwork.mjs",
    "node:sample-cids": "node scripts/nodeKeeper.mjs sample-cids",
    "node:pin-samples": "node scripts/nodeKeeper.mjs pin-samples",
    "node:spot-check": "node scripts/nodeKeeper.mjs spot-check",
    "node:heartbeat": "node scripts/nodeKeeper.mjs",
    "compile": "hardhat compile",
    "deploy:base": "hardhat run scripts/deploy.js --network base"
  },
  "repository": {
    "type": "git",
